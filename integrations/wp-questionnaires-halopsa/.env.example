# Runtime
DRY_RUN=true
POLL_ONCE=true
POLL_INTERVAL_SECONDS=300
PAGE_SIZE=25
MAX_RETRIES=3

# WP Questionnaires API
WPQ_BASE_URL=https://alltimetech.co.uk
WPQ_USERNAME=wpq-halopsa-api-user
WPQ_APPLICATION_PASSWORD=replace-with-wordpress-application-password

# HaloPSA API
HALO_BASE_URL=https://yourtenant.halopsa.com
HALO_CLIENT_ID=replace-with-halo-client-id
HALO_CLIENT_SECRET=replace-with-halo-client-secret
HALO_SCOPE=all
HALO_TOKEN_PATH=/auth/token

# HaloPSA endpoint paths. Override if your tenant/API version differs.
HALO_CLIENTS_PATH=/api/Client
HALO_USERS_PATH=/api/Users
HALO_PROSPECTS_PATH=/api/Opportunities
HALO_CUSTOM_FIELDS_PATH=/api/CustomFields

# CRM defaults. Use real tenant IDs after checking HaloPSA configuration.
HALO_PROSPECT_STATUS_ID=
HALO_PROSPECT_TYPE_ID=
HALO_PROSPECT_INTERESTED_STATUS_ID=
HALO_DEFAULT_PRIORITY_ID=

# Campaign/list handling.
# custom_field = write questionnaire name into the mapped campaign custom field.
# endpoint = also call HALO_CAMPAIGN_LISTS_PATH to resolve/create a list/campaign record.
HALO_CAMPAIGN_MODE=custom_field
HALO_CAMPAIGN_LISTS_PATH=
HALO_CAMPAIGN_NAME_FIELD=questionnaire_name

# Custom-field mapping file.
FIELD_MAP_PATH=./config/field-map.example.json
